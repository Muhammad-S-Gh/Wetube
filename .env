# -----------------------------
# General
# -----------------------------
UID=1000
GID=1000
NGINX_VERSION=1.29-alpine
PROMETHEUS_VERSION=v3.5.0
CADVISOR_VERSION=v0.49.1

# -----------------------------
# MYSQL
# -----------------------------
MYSQL_DATABASE=wetube_db
MYSQL_ROOT_PASSWORD=root
MYSQL_VERSION=8.0.46
MYSQL_EXPORTER_VERSION=v0.15.1

# -----------------------------
# GRAFANA
# -----------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_VERSION=12.0.1

# -----------------------------
# REDIS
# -----------------------------
REDIS_VERSION=alpine
REDIS_EXPORTER_VERSION=v1.61.0

# -----------------------------
# K6
# -----------------------------
K6_VERSION=1.0.0
K6_BASE_URL=http://nginx:80

# -----------------------------
# Influxdb
# -----------------------------
INFLUXDB_DB=wetube_k6
INFLUXDB_VERSION=1.8
INFLUXDB_PORT=8086
INFLUX_URL=http://influxdb:8086/wetube_k6
