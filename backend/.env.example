REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
CACHE_PREFIX=wetube

### Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_DB=0
REDIS_QUEUE_RETRY_AFTER=3600
REDIS_QUEUE=default
QUEUE_REDIS_DRIVER=redis
