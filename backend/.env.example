### App
APP_NAME=Wetube
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
VITE_APP_NAME="${APP_NAME}"

### Lang
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

### Log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

### General
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
VIDEOS_PER_PAGE=10

### Cache
CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=wetube-
CACHE_PREFIX=wetube

### Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_DB=0
REDIS_QUEUE_RETRY_AFTER=3600
FFMPEG_THREADS=2

### Session
SESSION_DRIVER=redis
SESSION_STORE=redis_sessions
SESSION_LIFETIME=120
SESSION_PREFIX=session-
REDIS_SESSION_CONNECTION=default
REDIS_SESSION_LOCK_CONNECTION=default
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

### DB
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wetube_db
DB_USERNAME=root
DB_PASSWORD=root

