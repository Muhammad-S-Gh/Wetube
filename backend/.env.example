APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
VIDEOS_PER_PAGE=10

### Cache
CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_CLIENT=phpredis
REDIS_URL=
