# Prometheus
PROMETHEUS_COLLECTOR_QUEUE_ENABLED=true
PROMETHEUS_COLLECTOR_HTTP_ENABLED=true
PROMETHEUS_COLLECTOR_DATABASE_ENABLED=true
PROMETHEUS_COLLECTOR_CACHE_ENABLED=true
PROMETHEUS_COLLECTOR_ERROR_ENABLED=true
